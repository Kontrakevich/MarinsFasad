{
  "name": "Marins Facade v0.8.0",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "forwardPorts": [8070],
  "portsAttributes": {
    "8070": {
      "label": "Marins Facade Control Center v0.8.0",
      "onAutoForward": "openBrowser",
      "visibility": "private"
    }
  },
  "postCreateCommand": "cd v080 && bash build.sh",
  "postStartCommand": "bash v080/start.sh",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python"
      ]
    }
  }
}
